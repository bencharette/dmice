{
  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(pdftotext \"pset06 \\(1\\).pdf\" -)",
      "Bash(pdftotext \"pset06 \\(1\\).pdf\" pset06_full.txt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/claude-viz/hook.py PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/claude-viz/hook.py PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/claude-viz/hook.py Stop"
          }
        ]
      }
    ]
  },
  "effortLevel": "medium"
}
